<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fixtures.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- So `tia verify` can read this project's outcomes from TRX. -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fixtures.Core/Fixtures.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
