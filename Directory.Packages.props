<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Roslyn per target framework (#182). The tool loads the analyzers and source generators of the
    projects it analyses into its own Roslyn, which refuses any built against a newer one: the Razor
    generator in SDK 10.0.403 references 5.9, and under 5.6 no Razor view or page was analysed.
    5.9 has a net10.0 asset that needs only Microsoft.Build.Framework 17.11, so net10.0 takes it.
    It has no net9.0 asset, and net9.0 would resolve its .NET Framework one (NU1701), so net9.0
    stays on 5.6, which is newer than anything an SDK-9 machine ships.
  -->
  <PropertyGroup>
    <RoslynVersion>5.6.0</RoslynVersion>
    <RoslynVersion Condition="'$(TargetFramework)' == 'net10.0'">5.9.0</RoslynVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!--
      Pulled in transitively by Microsoft.Build.Locator. It has to be referenced explicitly so it
      can carry ExcludeAssets="runtime" - see the comment in Tia.Workspace.csproj.
    -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.14.28" />
    <!--
      Carries Microsoft.Build.Evaluation, which is how a project's properties are read as MSBuild
      itself computes them rather than as they are spelled in XML. Same ExcludeAssets rule and same
      reason as Microsoft.Build.Framework above.
    -->
    <PackageVersion Include="Microsoft.Build" Version="17.14.28" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Lets the mutation harness read outcomes from a Microsoft.Testing.Platform run. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <!-- Validates reports against docs/report.schema.json (#94). Tests only. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>

</Project>
