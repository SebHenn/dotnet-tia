<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Implementation detail of the dotnet-tia tool, not a library anyone references. Without
         this, `dotnet pack tia.slnx` emits it as a publishable-looking package. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>Tia.Workspace</RootNamespace>
    <AssemblyName>Tia.Workspace</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />

    <!--
      Every Microsoft.Build.* reference MUST carry ExcludeAssets="runtime" and PrivateAssets="all".
      Without it the tool ships its own copies of the MSBuild assemblies, MSBuildLocator resolves
      those instead of the SDK's, and project evaluation dies with a MEF composition error.
      Microsoft.Build.Locator's own targets enforce this and fail the build (MSBL001) otherwise.
    -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tia.Core/Tia.Core.csproj" />
    <ProjectReference Include="../Tia.Frameworks/Tia.Frameworks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tia.Integration.Tests" />
  </ItemGroup>

</Project>
