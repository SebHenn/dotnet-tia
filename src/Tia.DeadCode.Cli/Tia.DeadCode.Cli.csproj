<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tia.DeadCode.Cli</RootNamespace>
    <AssemblyName>dotnet-deadcode</AssemblyName>
    <!-- Same reason as Tia.Cli: MSBuild is loaded into this process, and an MSBuild from a newer
         SDK cannot be loaded into an older runtime (#196). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- Packing is not publishing: every pack and push in ci.yml and release.yml names src/Tia.Cli and
       dotnet-tia.*.nupkg, so this project ships only when a release workflow is written for it. -->
  <PropertyGroup Label="dotnet tool packaging">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-deadcode</ToolCommandName>
    <PackageId>dotnet-deadcode</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nupkg</PackageOutputPath>
    <Description>Dead-code finder for .NET: reports declarations, packages and files that nothing reaches from an entry point or a test, and checks each finding by deleting it.</Description>
    <PackageTags>dead-code;unused-code;roslyn;ci;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tia.Core/Tia.Core.csproj" />
    <ProjectReference Include="../Tia.DeadCode/Tia.DeadCode.csproj" />
    <ProjectReference Include="../Tia.Workspace/Tia.Workspace.csproj" />
  </ItemGroup>

</Project>
