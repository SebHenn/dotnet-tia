<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Implementation detail of the dotnet-tia tool, not a library anyone references. Without
         this, `dotnet pack tia.slnx` emits it as a publishable-looking package. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>Tia.Frameworks</RootNamespace>
    <AssemblyName>Tia.Frameworks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tia.Core/Tia.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tia.Core.Tests" />
  </ItemGroup>

</Project>
