<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tia.Cli</RootNamespace>
    <AssemblyName>dotnet-tia</AssemblyName>
    <!-- The newest installed runtime, not merely a newer one when ours is missing. MSBuild is
         loaded into this process, and an MSBuild from a newer SDK cannot be loaded into an older
         runtime: with `Major`, a machine holding the .NET 10 runtime and the .NET 11 SDK ran the
         tool on .NET 10, found no MSBuild it could load for a solution pinned to the .NET 11 SDK,
         and every analysis there was a full run (#196). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <PropertyGroup Label="dotnet tool packaging">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-tia</ToolCommandName>
    <PackageId>dotnet-tia</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nupkg</PackageOutputPath>
    <Description>Test impact analysis for .NET: takes a git diff and runs only the tests that diff can affect.</Description>
    <PackageTags>testing;test-impact-analysis;tia;roslyn;ci;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tia.Core/Tia.Core.csproj" />
    <ProjectReference Include="../Tia.Frameworks/Tia.Frameworks.csproj" />
    <ProjectReference Include="../Tia.Workspace/Tia.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
